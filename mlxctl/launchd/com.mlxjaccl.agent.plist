<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mlxjaccl.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/mlx-cluster/libexec/mlxctl</string>
    <string>agent</string>
    <string>--config</string>
    <string>/path/to/mlx-cluster/mlxctl.toml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/path/to/mlx-cluster</string>
  <key>StandardOutPath</key>
  <string>/path/to/mlx-cluster/logs/agent.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/mlx-cluster/logs/agent.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
